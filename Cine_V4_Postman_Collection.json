{
	"info": {
		"_postman_id": "cine-v2-matricula-honor-2024",
		"name": "Cine V4 - Matrícula de Honor",
		"description": "Colección completa para probar todos los endpoints del API de Cine V2. Incluye autenticación JWT automática, control de roles RBAC y auditoría JPA.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{jwt_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080/api/v1",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "refresh_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Autenticación (Pública)",
			"item": [
				{
					"name": "Registrar nuevo usuario",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"var json = pm.response.json();",
									"if (json.accessToken) {",
									"    pm.collectionVariables.set('jwt_token', json.accessToken);",
									"    pm.collectionVariables.set('refresh_token', json.refreshToken);",
									"    console.log('✅ Tokens guardados desde Register');",
									"}",
									"pm.test('Status 201 Creado', () => pm.response.to.have.status(201));",
									"pm.test('Contiene accessToken', () => pm.expect(json.accessToken).to.not.be.undefined);"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"cliente@cine.com\",\n    \"password\": \"1234\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"register"
							]
						},
						"description": "Registra un nuevo usuario. El backend le asigna ROLE_USER automáticamente y devuelve accessToken + refreshToken. El script guarda los tokens en las variables de la colección."
					}
				},
				{
					"name": "Iniciar sesión (Login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"var json = pm.response.json();",
									"if (json.accessToken) {",
									"    pm.collectionVariables.set('jwt_token', json.accessToken);",
									"    pm.collectionVariables.set('refresh_token', json.refreshToken);",
									"    console.log('✅ Tokens guardados desde Login');",
									"}",
									"pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
									"pm.test('Contiene accessToken', () => pm.expect(json.accessToken).to.not.be.undefined);"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@cine.com\",\n    \"password\": \"admin\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Login con credenciales. Cambia el body a 'user@cine.com' / 'user' para probar con un usuario normal (ROLE_USER)."
					}
				},
				{
					"name": "Renovar Token (Refresh)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"var json = pm.response.json();",
									"if (json.accessToken) {",
									"    pm.collectionVariables.set('jwt_token', json.accessToken);",
									"    console.log('✅ Access Token renovado');",
									"}",
									"pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refreshToken\": \"{{refresh_token}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/refresh",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"refresh"
							]
						},
						"description": "Envía el refreshToken para obtener un nuevo accessToken sin volver a hacer login. El refreshToken dura 7 días."
					}
				}
			]
		},
